{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlatformConfig",
  "type": "object",
  "required": [
    "server",
    "database",
    "redis",
    "auth",
    "kubernetes",
    "argocd"
  ],
  "properties": {
    "server": {
      "type": "object",
      "required": ["name", "port", "admin_port"],
      "properties": {
        "name": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "admin_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "idle_timeout_seconds": { "type": "integer", "minimum": 1 },
        "header_timeout_seconds": { "type": "integer", "minimum": 1 },
        "drain_deadline_seconds": { "type": "integer", "minimum": 1 },
        "shutdown_deadline_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "database": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string" },
        "max_open_conns": { "type": "integer", "minimum": 1 },
        "max_idle_conns": { "type": "integer", "minimum": 1 },
        "conn_max_lifetime_minutes": { "type": "integer", "minimum": 1 }
      }
    },
    "redis": {
      "type": "object",
      "required": ["address"],
      "properties": {
        "address": { "type": "string" },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "auth": {
      "type": "object",
      "required": ["jwt_secret", "issuer"],
      "properties": {
        "jwt_secret": { "type": "string", "minLength": 16 },
        "issuer": { "type": "string" }
      }
    },
    "kubernetes": {
      "type": "object",
      "required": ["endpoint"],
      "properties": {
        "endpoint": { "type": "string" }
      }
    },
    "argocd": {
      "type": "object",
      "required": ["endpoint"],
      "properties": {
        "endpoint": { "type": "string" },
        "token": { "type": "string" }
      }
    },
    "gcp": {
      "type": "object",
      "properties": {
        "project_id": { "type": "string" },
        "cloud_sql_admin_url": { "type": "string" },
        "cloud_dns_url": { "type": "string" }
      }
    }
  }
}
