# ==============================================================================
# Internal Developer Platform - Frontend Developer Portal Environment Variables
# ==============================================================================
# Port for the Next.js developer portal server
PORT=7007

# Host bind address
HOST=0.0.0.0

# Base URL of the backend Go Platform API
# Client-side (browser) access URL
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8080

# Server-side (SSR / container) access URL
BACKEND_URL=http://127.0.0.1:8080
