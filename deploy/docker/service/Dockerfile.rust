# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE=debian:bookworm-slim
ARG BUILDER_IMAGE=rust:1.80-slim-bookworm

FROM ${BUILDER_IMAGE} AS builder
WORKDIR /build

COPY rust-modules/Cargo.toml rust-modules/Cargo.lock* ./
RUN mkdir src && echo "fn main() {}" > src/main.rs \
 && cargo build --release \
 && rm -rf src

COPY rust-modules/src/ ./src/
RUN touch src/main.rs \
 && cargo build --release \
 && cp target/release/$(cargo metadata --no-deps --format-version 1 | grep -o '"name":"[^"]*"' | head -1 | cut -d'"' -f4) /build/service-bin || cp target/release/* /build/service-bin 2>/dev/null || true

FROM ${BASE_IMAGE} AS runtime
ARG UID=10001
ARG GID=10001

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tini \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid ${GID} app 2>/dev/null || true \
 && useradd --uid ${UID} --gid ${GID} --no-create-home --shell /usr/sbin/nologin app 2>/dev/null || true \
 && chown -R ${UID}:${GID} /app

COPY --from=builder --chown=${UID}:${GID} /build/service-bin /app/service-bin

USER ${UID}:${GID}
EXPOSE 9000
ENTRYPOINT ["/usr/bin/tini", "--", "/app/service-bin"]
