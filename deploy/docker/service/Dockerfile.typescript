# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE=node:26.13.0-slim
ARG BUILDER_IMAGE=node:26.13.0-slim

FROM ${BUILDER_IMAGE} AS builder
WORKDIR /build

COPY typescript-modules/package.json typescript-modules/package-lock.json* typescript-modules/tsconfig.json* ./
RUN npm install --ignore-scripts

COPY typescript-modules/src/ ./src/
RUN npm run build || true

FROM ${BASE_IMAGE} AS runtime
ARG UID=10001
ARG GID=10001

ENV NODE_ENV=production
WORKDIR /app

RUN groupadd --gid ${GID} app 2>/dev/null || true \
 && useradd --uid ${UID} --gid ${GID} --no-create-home --shell /usr/sbin/nologin app 2>/dev/null || true \
 && chown -R ${UID}:${GID} /app

COPY --from=builder --chown=${UID}:${GID} /build/dist ./dist
COPY --from=builder --chown=${UID}:${GID} /build/node_modules ./node_modules
COPY --from=builder --chown=${UID}:${GID} /build/package.json ./package.json

USER ${UID}:${GID}
EXPOSE 7007
ENTRYPOINT ["node", "dist/index.js"]
