# ==============================================================================
# Internal Developer Platform - Environment Configuration Example
# ==============================================================================
# All variables defined here must strictly match config/env.schema
# Copy this file to .env for local development

APP_ENV=dev
PORT=8080
ADMIN_PORT=8081
METRICS_PORT=9090
LOG_LEVEL=debug

# Storage & Infrastructure (Local Docker Compose)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=idp_db
DB_USER=postgres
SECRETS_DIR=/tmp

# In-Memory Cache
CACHE_HOST=127.0.0.1
CACHE_PORT=6379

# OpenTelemetry Telemetry Collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Polyglot Worker Endpoints
RUST_WORKER_URL=http://127.0.0.1:9000
CPP_ENGINE_URL=http://127.0.0.1:9090
DEVELOPER_PORTAL_URL=http://127.0.0.1:7007
