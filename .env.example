# ==============================================================================
# Internal Developer Platform - Environment Configuration Example
# ==============================================================================
# All variables defined here must strictly match config/env.schema
# Copy this file to .env for local development

APP_ENV=dev
PORT=8080
ADMIN_PORT=8081
METRICS_PORT=9090
LOG_LEVEL=debug

# Storage & Infrastructure (Local Docker Compose)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/idp_db?sslmode=disable
REDIS_ADDR=127.0.0.1:6379

# Security & Authentication
JWT_SECRET=platform-secure-jwt-signing-key-production
AUTH_ISSUER=internal-developer-platform

# Infrastructure Client Endpoints
KUBERNETES_API_URL=https://k8s-api.internal:6443
ARGOCD_SERVER_URL=https://argocd.internal:443
ARGOCD_TOKEN=

# OpenTelemetry Telemetry Collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Polyglot Worker Endpoints
RUST_WORKER_URL=http://127.0.0.1:9000
CPP_ENGINE_URL=http://127.0.0.1:9090
DEVELOPER_PORTAL_URL=http://127.0.0.1:7007
